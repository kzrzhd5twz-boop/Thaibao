#!name = Locket Gold Photobooth + AI Filter
#!desc = Mở khóa toàn bộ tính năng cao cấp Locket
#!author = Custom Module

[Script]
# Sửa phản hồi máy chủ kiểm tra gói Premium Locket
locket_premium = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/v1\/subscribers\/.+$, script-path=https://raw.githubusercontent.com/mhieu08/locket/main/locket_gold.js, requires-body=true, max-size=-1

# Bỏ yêu cầu kiểm tra hóa đơn
locket_receipt = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/v1\/receipts$, script-path=https://raw.githubusercontent.com/mhieu08/locket/main/skip_check.js, requires-body=true

[MITM]
hostname = %APPEND% api.revenuecat.com
